<div id="preserve-test" tabindex="0" class="border p-2 my-3">
    @if (IsDestination)
    {
        <span>Enhanced navigation destination content</span>
    }
    else
    {
        <span>Enhanced navigation source content</span>
    }
</div>

@if (!IsDestination)
{
    <p><a href="preserve-result">Run enhanced navigation test</a></p>
}
else
{
    <p><a href="">Return to test start</a></p>
}

@code {
    [Parameter]
    public bool IsDestination { get; set; }
}
