<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <BasePath />
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["lib/bootstrap/dist/css/bootstrap.min.css"]" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["BlazorAppAuto.styles.css"]" />
    <ImportMap />
    <link rel="icon" type="image/png" href="favicon.png" />
    <HeadOutlet />
</head>

<body>
    <ConfigureBrowser Options="@RequestBrowserOptions" />
    <nav class="alert alert-secondary m-3 d-flex align-items-center gap-2" aria-label="Browser logging test">
        <strong>Browser logging:</strong>
        <a class="btn btn-outline-secondary btn-sm" href="@NormalLoggingUrl" target="_blank" data-enhance-nav="false">Warning</a>
        <a class="btn btn-outline-secondary btn-sm" href="@DetailedLoggingUrl" target="_blank" data-enhance-nav="false">Trace</a>
    </nav>
    <Routes />
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    private BrowserOptions RequestBrowserOptions => new()
    {
        LogLevel = IsDetailedRequest ? LogLevel.Trace : LogLevel.Warning
    };

    private string NormalLoggingUrl =>
        $"{HttpContext.Request.PathBase}{HttpContext.Request.Path}";

    private string DetailedLoggingUrl =>
        $"{NormalLoggingUrl}{QueryString.Create("detailed", "true")}";

    private bool IsDetailedRequest =>
        HttpContext.Request.Query.TryGetValue("detailed", out var queryValue) &&
            string.Equals(queryValue, "true", StringComparison.OrdinalIgnoreCase) ||
        HttpContext.Request.Headers.TryGetValue("X-Detailed-Logging", out var headerValue) &&
            string.Equals(headerValue, "true", StringComparison.OrdinalIgnoreCase);
}
