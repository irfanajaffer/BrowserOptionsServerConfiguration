<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <BasePath />
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["lib/bootstrap/dist/css/bootstrap.min.css"]" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["BlazorServerApp.styles.css"]" />
    <ImportMap />
    <link rel="icon" type="image/png" href="favicon.png" />
    <HeadOutlet />
</head>

<body>
    <ConfigureBrowser Options="@RequestBrowserOptions" />
    <div class="alert alert-info m-3" id="browser-options-diagnostics" role="status">
        <strong>BrowserOptions request isolation:</strong>
        server instance: <span id="server-instance">@ServerInstance</span>;
        Variant: <span id="request-variant">@RequestVariant</span>;
        per-request LogLevel supplied to ConfigureBrowser:
        <span id="configured-log-level">@RequestBrowserOptions.LogLevel</span>;
        URL: <span id="request-url">@RequestUrl</span>;
        request host: <span id="request-host">@HttpContext.Request.Host</span>;
        proxy host: <span id="proxy-host">@ProxyHost</span>;
        request ID: <span id="request-id">@HttpContext.TraceIdentifier</span>
    </div>
    <Routes />
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>

@code {
    [Inject]
    private IConfiguration Configuration { get; set; } = default!;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    private BrowserOptions RequestBrowserOptions => new()
    {
      LogLevel = IsDetailedRequest ? LogLevel.Trace : LogLevel.Warning
    };

    private string RequestVariant => IsDetailedRequest ? "detailed" : "normal";

    private string ServerInstance => Configuration["ServerInstance"] ?? Environment.MachineName;

    private string RequestUrl => $"{HttpContext.Request.Path}{HttpContext.Request.QueryString}";

    private string ProxyHost => HttpContext.Request.Headers.TryGetValue("X-Forwarded-Host", out var host)
        ? host.ToString()
        : "direct request";

    private bool IsDetailedRequest =>
        HttpContext.Request.Query.TryGetValue("detailed", out var queryValue) &&
            string.Equals(queryValue, "true", StringComparison.OrdinalIgnoreCase) ||
        HttpContext.Request.Headers.TryGetValue("X-Detailed-Logging", out var headerValue) &&
            string.Equals(headerValue, "true", StringComparison.OrdinalIgnoreCase);
}
